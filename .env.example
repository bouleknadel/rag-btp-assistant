# Copier ce fichier en `.env` et renseigner les clés. Ne jamais commiter `.env`.

# --- Fournisseurs LLM ---------------------------------------------------------
# Ordre d'essai : le fournisseur principal, puis les fallbacks dans l'ordre listé.
LLM_PROVIDER=groq
LLM_FALLBACKS=openai,gemini
LLM_TEMPERATURE=0.1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings & reranking (modèles locaux, aucune clé requise) -------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Vector store ---------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=btp_documents

# --- Ingestion & retrieval ----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# --- LangSmith (tracing & évaluation) -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-btp-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
