# Copier ce fichier en `.env` et renseigner les clés. Ne jamais commiter `.env`.

# --- Fournisseurs LLM ---------------------------------------------------------
# Ordre d'essai : le fournisseur principal, puis les fallbacks dans l'ordre listé.
LLM_PROVIDER=groq
LLM_FALLBACKS=openai,gemini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

GROQ_API_KEY=
# Llama 3.3 70B retiré de l'offre gratuite Groq le 16/08/2026 → gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
# Version stable (sept. 2026). Si quota dépassé : gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3+ uniquement : minimal, low, medium, high
GEMINI_THINKING_LEVEL=low

# --- Embeddings & reranking (modèles locaux, aucune clé requise) -------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Préfixes des modèles E5 (vider pour un autre modèle)
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Une fois les modèles téléchargés : évite les vérifications réseau au démarrage
# HF_HUB_OFFLINE=1

# --- Vector store ---------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=btp_documents

# --- Ingestion & retrieval ----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5

# --- Graphe RAG -------------------------------------------------------------------
MAX_QUERY_REWRITES=1

# --- LangSmith (tracing & évaluation) -----------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-btp-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
